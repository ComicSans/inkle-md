{
  "name": "story-weaver",
  "version": "0.1.0",
  "description": "A gamebook language in Markdown: compiler, linter and web export",
  "type": "module",
  "license": "MPL-2.0",
  "engines": { "node": ">=20" },
  "bin": { "story-weaver": "./src/cli.js" },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "lint:example": "node src/cli.js lint examples/thornwood-book/book.yaml --strict",
    "build:example": "node src/cli.js build examples/thornwood-book/book.yaml --out build/thornwood-book.json",
    "build:book": "node src/cli.js build examples/thornwood-book/book.yaml --out build/thornwood-book.json",
    "export:book": "node src/cli.js export examples/thornwood-book/book.yaml --out build/thornwood.html"
  }
}
