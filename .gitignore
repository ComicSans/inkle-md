# Compiler and export output
build/
dist/

# SwiftPM build output of hosts/ios
.build/
.swiftpm/

# Dependencies, should any ever appear
node_modules/

# Editors and operating systems
.DS_Store
*.swp
.idea/
.vscode/
# Ausnahme: der F5-Start der Erweiterung gehört zur Erweiterung.
!tools/vscode/.vscode/

# Local tooling state. The settings of the agent and the MCP servers it
# starts are one machine's setup, not the project's: paths, hooks and
# permissions differ per checkout. `.claude/launch.json` stays, it says how
# this project runs.
.tokensave/
.claude/settings.json
.claude/settings.local.json
.mcp.json

# Generated by the demo: xcodegen writes the project, inkle-md the books
hosts/demo/*.xcodeproj/
hosts/demo/Books/
